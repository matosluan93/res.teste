# ─────────────────────────────────────────────────────
# TalentOS — Variáveis de Ambiente
# cp .env.example .env e preencha os valores reais
# ─────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=
PORT=5000

# JWT
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# PostgreSQL
POSTGRES_DB=talentos_os
POSTGRES_USER=talentos
POSTGRES_PASSWORD=talentos_secret_dev
DATABASE_URL=postgresql://talentos:talentos_secret_dev@localhost:5432/talentos_os

# Redis
REDIS_PASSWORD=redis_secret_dev
REDIS_URL=redis://:redis_secret_dev@localhost:6379/0

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...sua-chave-aqui...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000

# Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=52428800

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/talentos.log

# Email (opcional — notificações)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@stefanini.com
